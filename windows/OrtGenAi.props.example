<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Point this at the folder that contains the ONNX Runtime GenAI include/ and lib/ directories. -->
    <OrtGenAiRoot>C:\path\to\onnxruntime-genai-win-x64</OrtGenAiRoot>

    <!-- Point this at the folder that contains the core ONNX Runtime include/ and lib/ directories.
         If you built ORT GenAI from source and both libs are in the same output folder, you can reuse the same path. -->
    <OrtRoot>C:\path\to\onnxruntime-win-x64</OrtRoot>
  </PropertyGroup>
</Project>
